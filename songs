local currentSound = nil
local songCache = {}
local debounce = false
local looping = false

local function stopCurrent()
    if currentSound then
        currentSound:Stop()
        currentSound:Destroy()
        currentSound = nil
    end
end

local buttonsBySong = {}

local function createSongButton(song, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(20, 80, 180)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Text = song.name
    btn.AutoButtonColor = true
    btn.LayoutOrder = order
    btn.BorderSizePixel = 0
    btn.Parent = scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    btn.Activated:Connect(function()
        if debounce then return end
        debounce = true

        stopCurrent()
        nowPlaying.Text = "Loading: " .. song.name

        task.spawn(function()
            local soundId = songCache[song.id]
            if not soundId then
                local success, result = pcall(function()
                    local fileName = "song_cache_" .. order .. ".mp3"
                    if not isfile(fileName) then
                        writefile(fileName, game:HttpGet(song.id))
                    end
                    return getcustomasset(fileName)
                end)
                if success and result then
                    soundId = result
                    songCache[song.id] = soundId
                else
                    soundId = song.id
                end
            end

                        local sound = Instance.new("Sound")
            sound.SoundId = soundId
            sound.Volume = volumeLevel
            sound.Looped = looping
            sound.Parent = workspace
            sound:Play()
            currentSound = sound
            nowPlaying.Text = "Now playing: " .. song.name
            
            for _, b in pairs(buttonsBySong) do
                b.BackgroundColor3 = Color3.fromRGB(20, 80, 180)
            end
            btn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        end)

        task.delay(0.4, function()
            debounce = false
        end)
    end)

    buttonsBySong[song.name] = btn
end

for i, song in ipairs(SONGS) do
    createSongButton(song, i)
end

